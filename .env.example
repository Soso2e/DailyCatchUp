# ===== News API =====
NEWS_API_KEY=your_newsapi_key_here

# ===== NotebookLM (Google Account) =====
GOOGLE_EMAIL=your_google_email@gmail.com
GOOGLE_PASSWORD=your_google_password

# ===== Claude API =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ===== Discord =====
# Webhook URL for morning/night posts (no bot required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Bot token for slash command support
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id

# ===== YouTube =====
# Path to OAuth2 client_secret.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=.youtube_token.json
# "unlisted" for testing, "public" for production
YOUTUBE_PRIVACY_STATUS=unlisted

# ===== Notion =====
NOTION_API_KEY=secret_your_notion_integration_key
NOTION_DATABASE_ID=your_notion_database_id

# ===== Pipeline Settings =====
OUTPUTS_DIR=outputs
MAX_ARTICLES=5
MIN_ARTICLES=2
NEWS_MAX_AGE_HOURS=24
# NotebookLM polling: check every 60s, give up after 900s (15min)
NOTEBOOKLM_POLL_INTERVAL=60
NOTEBOOKLM_MAX_WAIT=900
RETRY_COUNT=3
RETRY_BACKOFF=5.0
